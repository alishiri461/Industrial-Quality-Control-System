APP_NAME=Industrial Quality Control System
APP_ENV=development
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=./data/inspection.sqlite3
ARTIFACTS_DIR=./artifacts
LOG_LEVEL=INFO
# Use a JSON array. Keep real credentials in the protected local .env, never in Git.
# Example only (replace host/user/password with approved camera details):
# CAMERAS_JSON=[{"id":"line-01-cam-01","name":"Line 01 Camera 01","source_type":"rtsp","source_url":"rtsp://user:password@10.0.0.20:554/stream1","enabled":true,"open_timeout_ms":5000,"read_timeout_ms":5000}]
CAMERAS_JSON=[]
# Model loading is intentionally disabled until licensing/data/hardware are approved.
INFERENCE_BACKEND=disabled
MODEL_PATH=
MODEL_VERSION=unconfigured
